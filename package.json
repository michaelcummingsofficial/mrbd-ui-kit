{
	"name": "mrbd-ui-kit-monorepo",
	"private": true,
	"workspaces": [
		"packages/*"
	],
	"packageManager": "pnpm@11.20.0",
	"scripts": {
		"build": "turbo build",
		"dev": "turbo dev",
		"format": "eslint . --fix && prettier --write \"**/*.{ts,tsx}\"",
		"lint": "eslint .",
		"typecheck": "turbo typecheck",
		"clean": "turbo clean"
	},
	"license": "MIT",
	"devDependencies": {
		"@typescript-eslint/eslint-plugin": "^8.70.1",
		"@typescript-eslint/parser": "^8.70.1",
		"eslint": "^10.11.0",
		"eslint-plugin-import-x": "^4.17.1",
		"eslint-plugin-react-hooks": "^7.1.1",
		"eslint-plugin-tailwind-canonical-classes": "^1.4.1",
		"jiti": "^2.7.0",
		"next": "16.3.6",
		"prettier": "^3.9.9",
		"prettier-plugin-organize-imports": "^4.3.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"turbo": "^2.11.3",
		"typescript": "^6.0.3"
	}
}
